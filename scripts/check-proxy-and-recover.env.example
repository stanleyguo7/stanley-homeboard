# 复制为 scripts/check-proxy-and-recover.env 后按需调整
# source scripts/check-proxy-and-recover.env && scripts/check-proxy-and-recover.sh

ROUTER_HOST=192.168.8.1
ROUTER_USER=root
ROUTER_PORT=22

# 候选顺序：HK 主、JP 备、其余 HK 备（按顺序轮换）
PASSWALL_NODE_CANDIDATES=UzTVquFq,xzxahlJM,EbwPbIjt,3hM1UlM5,xmSej0SS,xntk7LOr,1LS0CrM5,MdqQsgr9

# 留空让脚本自动探测写入位置：
# - 可能是 passwall2.@global[0].tcp_node
# - 也可能是 passwall2.myshunt.default_node
PASSWALL_TARGET_SECTION=
PASSWALL_NODE_OPTION=

CHECK_URLS=https://www.google.com/generate_204,https://www.gstatic.com/generate_204,https://www.youtube.com
CHECK_RETRIES=2
CHECK_TIMEOUT=8

# 防抖与回切
FAIL_THRESHOLD=3
RECOVER_THRESHOLD=2
PREFER_PRIMARY=1
PASSWALL_PRIMARY_NODE=UzTVquFq
PROXY_STATE_FILE=/tmp/check-proxy-state
SWITCH_COOLDOWN_SEC=600
STRUCTURED_LOG_FILE=/home/guosq/.openclaw/workspace/stanley-homeboard/scripts/check-proxy-and-recover.jsonl
