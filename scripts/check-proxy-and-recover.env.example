# 复制为 .env 后 source 使用：
#   set -a; source scripts/check-proxy-and-recover.env; set +a

ROUTER_HOST=192.168.8.1
ROUTER_USER=root
ROUTER_PORT=22

# 连通性探测
CHECK_URLS=https://www.google.com/generate_204,https://www.gstatic.com/generate_204,https://www.youtube.com
CHECK_RETRIES=2
CHECK_TIMEOUT=8

# passwall2 恢复命令
ROUTER_RELOAD_CMD="/etc/init.d/passwall2 reload || /etc/init.d/passwall2 restart"

# 你当前配置下会自动探测到：passwall2.myshunt.default_node
# 因此下面两项可不填；若要强制指定可取消注释：
# PASSWALL_TARGET_SECTION=myshunt
# PASSWALL_NODE_OPTION=default_node

# Hong Kong 候选节点（已从路由器当前配置读取）
# 当前默认节点：3hM1UlM5 (🇭🇰 Hong Kong 05)
PASSWALL_NODE_CANDIDATES=3hM1UlM5,UzTVquFq,EbwPbIjt,xmSej0SS,xntk7LOr,1LS0CrM5,MdqQsgr9
